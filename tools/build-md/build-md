#!/usr/bin/env node
// Generates Markdown files in src/dates/ and moves MP3s to src/media/<date>/ from 01-mp3s/. See --help.
import fs from 'node:fs';
import path from 'node:path';

const SETTINGS = {
  inDir: './01-mp3s',
  outDir: './src/dates',
  mediaDir: './src/media',
  mediaPrefix: '../../media',
  personnel: 'TBD',
  // YAML frontmatter preamble placed at the top of generated markdown files.
  // Can be an object of key/values, a template string, or null/false to disable.
  // Template variables available: {{isoDate}}, {{formattedDate}}, {{date}}, {{personnel}}.
  yamlPreamble: {
    date: '{{isoDate}}',
    title: '{{formattedDate}}',
  },
};

const FLAGS = { verbose: false };

const HELP = `Usage: build-md [options] [file.mp3 ...]

Scans MP3 files (by default in 01-mp3s/) and generates corresponding Markdown
files in src/dates/ named after the 6-digit date prefix (e.g. 240101.md).
Each Markdown file contains:
  - Configurable YAML preamble frontmatter
  - Level 1 heading (#) with the long form date (e.g. # Monday, January 1, 2024)
  - Level 2 heading (##) for personnel (e.g. ## Personnel: TBD)
  - Ordered list of song links with targets in media/<date>/
Also moves the processed MP3 files into src/media/<date>/ (or --media-dir/<date>/).

Options
  --help, -h            Show this help
  --verbose, -v         Print verbose output
  --in-dir=path         Folder containing source MP3s        (default: ./01-mp3s)
                        (--inDir=path also works)
  --out-dir=path        Folder for the generated Markdown    (default: ./src/dates)
                        (--outDir=path also works)
  --media-dir=path      Folder to move MP3 files into        (default: ./src/media)
                        (--mediaDir=path also works)
  --media-prefix=path   Prefix for media links in Markdown   (default: media)
                        (--mediaPrefix=path also works)
  --personnel=str       Personnel value in markdown header   (default: TBD)
  --yaml-preamble=str   Custom YAML preamble template/JSON   (default: date & title)
                        (--yamlPreamble=str also works)

Examples
  build-md
  build-md --in-dir=./01-mp3s --out-dir=./src/dates --media-dir=./src/media
  build-md 01-mp3s/240101-*.mp3

Exits with code 1 on failure.
`;

const c = (code, s) => (process.stdout.isTTY ? `\x1b[${code}m${s}\x1b[0m` : s);
const fail = (msg) => { console.error(c(31, msg)); process.exit(1); };

const positionalArgs = [];
for (const a of process.argv.slice(2)) {
  if (a === '-v') { FLAGS.verbose = true; continue; }
  if (a === '--help' || a === '-h') { console.log(HELP); process.exit(0); }
  const m = a.match(/^--([\w-]+)(?:=(.*))?$/);
  if (!m) { positionalArgs.push(a); continue; }
  const [, k, v] = m;
  if (k === 'verbose') { FLAGS.verbose = true; continue; }
  const key = k.replace(/-(\w)/g, (_, ch) => ch.toUpperCase());
  if (key === 'yamlPreamble') {
    if (v === undefined || v === '') fail(`Bad value for --${k}`);
    try {
      SETTINGS.yamlPreamble = JSON.parse(v);
    } catch {
      SETTINGS.yamlPreamble = v;
    }
    continue;
  }
  if (key === 'inDir' || key === 'outDir' || key === 'mediaDir' || key === 'mediaPrefix' || key === 'personnel') {
    if (v === undefined || v === '') fail(`Bad value for --${k}`);
    SETTINGS[key] = v;
    continue;
  }
  fail(`Unknown option --${k}`);
}

function formatLongDate(dateStr) {
  const match = dateStr.match(/^(\d{2})(\d{2})(\d{2})/);
  if (!match) return dateStr;
  const year = 2000 + parseInt(match[1], 10);
  const month = parseInt(match[2], 10);
  const day = parseInt(match[3], 10);
  const d = new Date(Date.UTC(year, month - 1, day, 12, 0, 0));
  if (Number.isNaN(d.getTime())) return dateStr;
  const formatter = new Intl.DateTimeFormat('en-US', {
    weekday: 'long',
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
  return formatter.format(d);
}

function formatIsoDate(dateStr) {
  const match = dateStr.match(/^(\d{2})(\d{2})(\d{2})/);
  if (!match) return dateStr;
  const year = 2000 + parseInt(match[1], 10);
  const month = match[2];
  const day = match[3];
  return `${year}-${month}-${day}`;
}

function renderYamlPreamble(dateStr, formattedDate) {
  if (!SETTINGS.yamlPreamble) return '';
  const isoDate = formatIsoDate(dateStr);
  const context = {
    date: dateStr,
    isoDate,
    formattedDate,
    personnel: SETTINGS.personnel,
  };

  if (typeof SETTINGS.yamlPreamble === 'string') {
    let raw = SETTINGS.yamlPreamble;
    for (const [k, val] of Object.entries(context)) {
      raw = raw.replaceAll(`{{${k}}}`, val);
    }
    const trimmed = raw.trim();
    if (!trimmed) return '';
    return `---\n${trimmed}\n---\n\n`;
  }

  if (typeof SETTINGS.yamlPreamble === 'object' && SETTINGS.yamlPreamble !== null) {
    const lines = ['---'];
    for (const [k, val] of Object.entries(SETTINGS.yamlPreamble)) {
      let resolvedVal = String(val);
      for (const [ctxKey, ctxVal] of Object.entries(context)) {
        resolvedVal = resolvedVal.replaceAll(`{{${ctxKey}}}`, ctxVal);
      }
      lines.push(`${k}: ${resolvedVal}`);
    }
    lines.push('---');
    return lines.join('\n') + '\n\n';
  }

  return '';
}

function collectFiles() {
  const fileList = [];
  if (positionalArgs.length > 0) {
    for (const arg of positionalArgs) {
      if (!fs.existsSync(arg)) {
        fail(`File or directory not found: ${arg}`);
      }
      const stat = fs.statSync(arg);
      if (stat.isDirectory()) {
        const entries = fs.readdirSync(arg);
        for (const entry of entries) {
          if (entry.startsWith('.')) continue;
          fileList.push({ filename: entry, sourcePath: path.join(arg, entry) });
        }
      } else {
        fileList.push({ filename: path.basename(arg), sourcePath: arg });
      }
    }
  } else {
    if (!fs.existsSync(SETTINGS.inDir)) {
      fail(`Input directory not found: ${SETTINGS.inDir}`);
    }
    const entries = fs.readdirSync(SETTINGS.inDir);
    for (const entry of entries) {
      if (entry.startsWith('.')) continue;
      fileList.push({ filename: entry, sourcePath: path.join(SETTINGS.inDir, entry) });
    }
  }
  return fileList;
}

function getTargetFilename(filename, date) {
  const stripped = filename.replace(new RegExp(`^${date}[-_]?`), '');
  return (stripped && stripped !== path.extname(filename)) ? stripped : filename;
}

function moveFile(source, dest) {
  if (path.resolve(source) === path.resolve(dest)) return;
  try {
    fs.renameSync(source, dest);
  } catch (err) {
    if (err.code === 'EXDEV') {
      fs.copyFileSync(source, dest);
      fs.unlinkSync(source);
    } else {
      throw err;
    }
  }
}

function main() {
  const files = collectFiles();
  const dateGroups = new Map();

  for (const item of files) {
    const match = item.filename.match(/^(\d{6})/);
    if (!match) {
      if (FLAGS.verbose) {
        console.log(`Skipping file without 6-digit date prefix: ${item.filename}`);
      }
      continue;
    }
    const date = match[1];
    if (!dateGroups.has(date)) {
      dateGroups.set(date, []);
    }
    dateGroups.get(date).push(item);
  }

  if (dateGroups.size === 0) {
    if (FLAGS.verbose) {
      console.log('No dated files found to process.');
    }
    return;
  }

  fs.mkdirSync(SETTINGS.outDir, { recursive: true });
  fs.mkdirSync(SETTINGS.mediaDir, { recursive: true });

  const mediaPrefix = SETTINGS.mediaPrefix ? SETTINGS.mediaPrefix.replace(/\/+$/, '') : 'media';

  const sortedDates = Array.from(dateGroups.keys()).sort();
  for (const date of sortedDates) {
    const songs = dateGroups.get(date);
    songs.sort((a, b) => a.filename.localeCompare(b.filename, undefined, { numeric: true, sensitivity: 'base' }));

    const dateMediaDir = path.join(SETTINGS.mediaDir, date);
    fs.mkdirSync(dateMediaDir, { recursive: true });

    const longDate = formatLongDate(date);
    const preamble = renderYamlPreamble(date, longDate);
    const headerSection = `# ${longDate}\n\n## Personnel: ${SETTINGS.personnel}\n\n`;

    const songLines = songs.map((song, idx) => {
      const targetName = getTargetFilename(song.filename, date);
      return `${idx + 1}. [${targetName}](${mediaPrefix}/${date}/${targetName})`;
    });
    const content = `${preamble}${headerSection}${songLines.join('\n')}\n`;

    const outFile = path.join(SETTINGS.outDir, `${date}.md`);
    fs.writeFileSync(outFile, content, 'utf8');

    if (FLAGS.verbose) {
      console.log(`Wrote ${outFile} (${songs.length} song${songs.length === 1 ? '' : 's'})`);
    }

    for (const song of songs) {
      const targetName = getTargetFilename(song.filename, date);
      const destFile = path.join(dateMediaDir, targetName);
      moveFile(song.sourcePath, destFile);
      if (FLAGS.verbose) {
        console.log(`Moved ${song.sourcePath} -> ${destFile}`);
      }
    }
  }
}

try {
  main();
} catch (err) {
  fail(err.message);
}
